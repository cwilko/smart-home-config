{
    "mcpServers": {
        "mqtt": {
            "command": "sh",
            "args": ["-c", "pip install -q mqtt-mcp-server && python3 -m mqtt_mcp.server"],
            "env": {
                "MQTT_HOST": "mqtt.automation.svc.cluster.local",
                "MQTT_PORT": "1883"
            }
        },
        "github": {
            "command": "sh",
            "args": [
                "-c",
                "curl -sL https://github.com/github/github-mcp-server/releases/download/v2.0.2/github-mcp-server_Linux_x86_64.tar.gz | tar xz -C /tmp github-mcp-server && /tmp/github-mcp-server stdio"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}",
                "GITHUB_TOOLSETS": "repos,pull_requests"
            }
        }
    }
}
