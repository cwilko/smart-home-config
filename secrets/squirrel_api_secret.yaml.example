#kubectl create secret generic squirrel-api-secret --namespace services \
#  --from-literal=SQUIRREL_API_TOKEN="$(openssl rand -hex 32)" --dry-run=client -o yaml > secrets/squirrel_api_secret.yaml

apiVersion: v1
kind: Secret
metadata:
  creationTimestamp: null
  name: squirrel-api-secret
  namespace: services
data:
  SQUIRREL_API_TOKEN: <TOKEN>
