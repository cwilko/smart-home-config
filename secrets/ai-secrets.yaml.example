# To generate sealed secret:
#
# kubeseal -o yaml < ai-secrets.yaml > ai-sealed-secrets.yaml
#

apiVersion: v1

kind: Secret
metadata:
  name: ai-secrets
  namespace: automation
type: Opaque
stringData:
  GEMINI_API_KEY: <GEMINI API KEY>
  CLAUDE_CODE_OAUTH_TOKEN: <CLAUDE API KEY>
  GITHUB_PERSONAL_ACCESS_TOKEN: <GITHUB PAT>
